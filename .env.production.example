# Party Panic: production settings for shared hosting (Combell).
# Copy to `.env` on the server and fill in everything marked with <...>.

APP_NAME="Party Panic"
APP_ENV=production
# Generate once on the server: php artisan key:generate
APP_KEY=
APP_DEBUG=false
APP_URL=https://<jouw-domein.be>

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

# Combell control panel > Databases: host, database name, user and password.
DB_CONNECTION=mysql
DB_HOST=<mysql-host-van-combell>
DB_PORT=3306
DB_DATABASE=<database-naam>
DB_USERNAME=<database-gebruiker>
DB_PASSWORD=<database-wachtwoord>

SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Only send the login cookie over HTTPS.
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
# Broadcasts are sent immediately, so no queue worker is needed.
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Realtime: Pusher Channels (app with "Enable client events" switched on).
BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=<pusher-app-id>
PUSHER_APP_KEY=<pusher-key>
PUSHER_APP_SECRET=<pusher-secret>
PUSHER_APP_CLUSTER=eu
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https

# No e-mails are sent yet (password reset would need e.g. Resend).
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@<jouw-domein.be>"
MAIL_FROM_NAME="${APP_NAME}"

# Baked into the game at build time (npm run build reads this file's values from .env).
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"

# Laravel backend the dev server proxies /api and /broadcasting to.
BACKEND_URL=http://party-panic.test

# Realtime connection (Pusher protocol).
# Local Reverb: key from backend/.env REVERB_APP_KEY, host localhost, port 8080, scheme http.
# Pusher: set VITE_PUSHER_CLUSTER (e.g. eu) and leave host/port empty.
VITE_PUSHER_KEY=
VITE_PUSHER_CLUSTER=mt1
VITE_PUSHER_HOST=localhost
VITE_PUSHER_PORT=8080
VITE_PUSHER_SCHEME=http
